{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "types/global.d.ts",
    "background.js",
    "content/**/*.js",
    "lib/**/*",
    "analysis/**/*",
    "di/**/*",
    "data/**/*",
    "services/**/*",
    "components/**/*",
    "surfaces/**/*",
    "viewer/js/**/*",
    "panel/*",
    "settings/*"
  ],
  "exclude": [
    "**/vendor/**",
    "dist/**",
    "node_modules/**",
    "tools/**"
  ]
}
